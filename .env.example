# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=collnotes

# Backend database connection (must match postgres credentials above)
# Host stays `postgres` — it's the docker-compose service name
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/collnotes

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# App
NODE_ENV=production
PORT=3001
WS_PORT=3002

# Public-facing URL (use https:// in production)
FRONTEND_URL=https://your-domain.com

# Frontend WebSocket URL — BUILD-time (baked into the static bundle by Vite).
# Setting this as a runtime env on the frontend container does nothing.
# Use wss:// in production. Two patterns:
#   - Subdomain:    wss://ws.your-domain.com
#   - Path-routed:  wss://your-domain.com/collab  (needs Traefik/nginx path rule)
VITE_COLLAB_WS_URL=wss://ws.your-domain.com

# Editor auto-save debounce in milliseconds (default: 500, minimum recommended: 300)
# BUILD-time — baked into the frontend bundle
VITE_SAVE_DEBOUNCE_MS=500
